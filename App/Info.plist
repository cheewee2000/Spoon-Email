<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode merges the INFOPLIST_KEY_* build settings into this file, so
	     only the keys that have no INFOPLIST_KEY_ equivalent live here.
	     Both are ignored on macOS. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cwandt.spoon</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>spoon</string>
			</array>
		</dict>
		<!-- Lets Settings make Spoon the Mac's default mail app. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cwandt.spoon.mailto</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mailto</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- Plenty of email still points its images at plain http:// (older
	     newsletter hosts, animated GIFs especially). ATS blocks those inside
	     WKWebView, leaving a hole; this lifts it for web content only — the
	     app's own networking stays https-only. Applies on macOS too. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Sparkle (macOS only). The public key pairs with the private one in
	     the login keychain that Tools/release.sh signs each zip with. -->
	<key>SUFeedURL</key>
	<string>https://www.experiments.cwandt.com/spoon/mac/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>IsZ2LtddRqNHFHsp6U40Gw/A6sWIJO4m5xJYr1r4qic=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.cwandt.spoon.refresh</string>
	</array>
</dict>
</plist>
